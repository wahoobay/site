---
// The one navigation bar: the five sections with Fish ID after Live reef (src/lib/nav.mjs), Donate (the old site's
// Zeffy form), then sign-in (signInLink: not on the sighting review, which has its own sign-in and Sign out).
// `over` lays it over the top of the home page's hero (the design's wb-nav--over: transparent, the logo and links
// white). On the dark home page its links need no waiver: white is 4.5:1 or better on the hero's water, under a ray too
// (@wahoobay/design 0.5.0's tests), and the detector, measuring white on the deep ground, agrees.
// Fish ID leaves the site: the design's external icon after its label says so (Ruling Z), as well as the words for a
// screen reader.
import external from '@wahoobay/design/icons/external.svg?raw';
import Logo from './Logo.astro';
import { aiUrl, mainNav, signInLink } from '../lib/nav.mjs';

interface Props {
  over?: boolean;
}

const { over = false } = Astro.props;
// The fish-ID app's address differs per environment: the deploy workflow sets PUBLIC_AI_URL at build time.
const items = mainNav(aiUrl(import.meta.env.PUBLIC_AI_URL));
const donate = 'https://www.zeffy.com/en-US/donation-form/together-for-tomorrow-2';

// A section is current on its own page and every page below it; the home page marks none.
// aria-current is "page" on the section's own page and "true" on a page below it.
const path = Astro.url.pathname;
const signIn = signInLink(path);
const isOn = (href: string) => path.startsWith(href);
const current = (href: string) => (path === href ? 'page' : isOn(href) ? 'true' : undefined);
---
<nav class:list={['wb-nav', { 'wb-nav--over': over }]} aria-label="Main">
  <a class="wb-nav__logo" href="/"><Logo /></a>
  <ul class="wb-nav__links">
    {items.map(({ label, href, external: leaves }) => (
      <li>
        {leaves ? (
          <a class="wb-nav__link" href={href} target="_blank" rel="noopener">{label}<Fragment set:html={external.trim()} /><span class="wb-sr-only"> (opens in a new tab)</span></a>
        ) : (
          <a class:list={['wb-nav__link', { 'wb-nav__link--on': isOn(href) }]} href={href} aria-current={current(href)}>{label}</a>
        )}
      </li>
    ))}
  </ul>
  <a class="wb-btn wb-btn--accent wb-nav__cta" href={donate} target="_blank" rel="noopener">Donate<span class="wb-sr-only"> (opens in a new tab)</span></a>
  {signIn && <a class:list={['wb-nav__link', { 'wb-nav__link--on': isOn(signIn.href) }]} href={signIn.href} aria-current={current(signIn.href)}>{signIn.label}</a>}
</nav>
