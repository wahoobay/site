---
// The home page's three ways in, as the design's photo doorways: each 4:5 photograph is one link, its title and
// sentence on the picture over the scrim. The photos are decorative (alt=""): the link is named by its heading and
// sentence. The text on the photograph carries the low-contrast waiver (Ruling A): the detector sees neither the
// photograph nor the scrim.
// Get involved is the volunteer divers (Ruling J): the photo carries the Wahoo Bay watermark at its top left and the
// Grateful Divers credit at its bottom right, and the 4:5 frame keeps the middle 53% of this 3:2 photo's width (more
// where a long title makes the door taller), so neither corner is in the picture at any width.

// One sentence each, from the old site: WaysToVisit.js, MainPage/EducationSection.js, MainPage/GetInvolvedSection.js.
const doorways = [
  {
    title: 'Visit',
    href: '/visit/',
    text: 'Wahoo Bay sits within the Hillsboro Inlet at Roy L. Rogers Family Park.',
    image: '/images/home/diver.jpg',
    width: 800,
    height: 533,
  },
  {
    title: 'Learn',
    href: '/learn/',
    text: 'Explore the many educational resources available right here on our website.',
    image: '/images/home/students.jpg',
    width: 800,
    height: 602,
  },
  {
    title: 'Get involved',
    href: '/get-involved/',
    text: 'Join our conservation mission and inspire others to protect marine ecosystems.',
    image: '/images/about/2025-gd-wb-816-lwb-06.jpg',
    width: 1600,
    height: 1066,
  },
];
---
<section class="wb-container site-doors" aria-label="Ways in">
  {doorways.map((door) => (
    <a class="wb-door" href={door.href}>
      <img class="wb-door__photo" src={door.image} width={door.width} height={door.height} alt="" loading="lazy">
      <div class="wb-door__body"><h2 class="wb-door__title" data-impeccable-ignore="low-contrast">{door.title}</h2><p class="wb-door__text" data-impeccable-ignore="low-contrast">{door.text}</p></div>
    </a>
  ))}
</section>
