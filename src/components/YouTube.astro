---
// A YouTube video, or with `playlist` a playlist, from youtube-nocookie.com: no cookies until it plays, and it never
// starts by itself. In the design's 16:9 video frame. Only the Live reef pages embed video. The address is
// src/lib/video.mjs's, which the live camera's player embeds too.
import { EMBED_ALLOW, embedUrl } from '../lib/video.mjs';

interface Props {
  /** The video's id, or the playlist's with `playlist`. */
  id: string;
  /** What the frame shows, for screen readers. */
  title: string;
  playlist?: boolean;
}

const { id, title, playlist = false } = Astro.props;
const src = embedUrl(id, { playlist });
---
<div class="wb-video site-video">
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow={EMBED_ALLOW}
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>
