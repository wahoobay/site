---
// A YouTube video, or with `playlist` a playlist, from youtube-nocookie.com: no cookies until it plays, and it never
// starts by itself, except with `autoplay` (the home page's live band only: muted, starting as it nears the screen, the
// frame loading lazily). In the design's 16:9 video frame. The address is src/lib/video.mjs's, which the live camera's
// player embeds too.
import { EMBED_ALLOW, EMBED_ALLOW_AUTOPLAY, embedUrl } from '../lib/video.mjs';

interface Props {
  /** The video's id, or the playlist's with `playlist`. */
  id: string;
  /** What the frame shows, for screen readers. */
  title: string;
  playlist?: boolean;
  /** Muted, starting by itself: the home band's live stream only. */
  autoplay?: boolean;
}

const { id, title, playlist = false, autoplay = false } = Astro.props;
const src = embedUrl(id, { playlist, autoplay });
---
<div class="wb-video site-video">
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow={autoplay ? EMBED_ALLOW_AUTOPLAY : EMBED_ALLOW}
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>
