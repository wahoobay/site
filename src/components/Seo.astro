---
// Head metadata for every page: title, description, canonical URL, Open Graph and Twitter card.
interface Props {
  title: string;
  description: string;
  /** A path under public/ or an absolute URL; defaults to the home page photo. */
  image?: string;
  /** Keep the page out of search results; it then names no canonical URL (the 404 page). */
  noindex?: boolean;
}

const { title, description, image = '/WB-1.jpg', noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://wahoobay.net');
const fullTitle = Astro.url.pathname === '/' ? 'Wahoo Bay' : `${title} · Wahoo Bay`;
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
---
<title>{fullTitle}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Wahoo Bay">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:image" content={imageUrl}>
{!noindex && <meta property="og:url" content={canonical}>}
<meta name="twitter:card" content="summary_large_image">
