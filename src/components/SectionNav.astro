---
// "In this section": the pages of one section (src/lib/sections.ts), led by the section's own page when that page
// is outside the pages collection (sectionLead), the current one marked. Shown when it lists a page other than
// this one: a page alone in its section has nowhere to send the reader.
import { sectionLead, sectionPages, urlOf, type PageEntry } from '../lib/sections';

interface Props {
  section: PageEntry['data']['section'];
  /** This page's address. */
  here: string;
}

const { section, here } = Astro.props;
const lead = sectionLead[section];
const links = [
  ...(lead ? [lead] : []),
  ...(await sectionPages(section)).map((page) => ({ href: urlOf(page), label: page.data.nav ?? page.data.title })),
];
---
{links.some((link) => link.href !== here) && (
  <nav class="site-subnav" aria-label="In this section">
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a
            class:list={['wb-nav__link', { 'wb-nav__link--on': href === here }]}
            href={href}
            aria-current={href === here ? 'page' : undefined}
          >{label}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
