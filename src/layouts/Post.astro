---
// One news post: the h1, its date, its photo, the Markdown body and a link back to /news/.
import Base from './Base.astro';
import { isoDay, longDay } from '../lib/dates';
import { publicImageSize } from '../lib/public-image.mjs';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { title, description, date, image } = entry.data;
const size = image ? await publicImageSize(image) : undefined;
---
<Base title={title} description={description} image={image}>
  <div class="wb-container site-article">
    <p><a href="/news/">&larr; All news</a></p>
    <h1>{title}</h1>
    <p><time datetime={isoDay(date)}>{longDay(date)}</time></p>
    {image && size && <img class="site-post__image" src={image} width={size.width} height={size.height} alt="" fetchpriority="high">}
    <div class="wb-prose site-article__body"><slot /></div>
  </div>
</Base>
