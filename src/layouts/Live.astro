---
// A Live reef page (src/content/live/*.md), on the dark ground, in this order at every width (Ruling 47; markup order,
// no CSS reordering): the Live reef navigation, the h1 (with the live badge when the video is the stream), the video,
// the lead and a link to the other live page, what the page puts after the video (the `after` slot), then the Markdown
// body. The navigation is above the h1, where Page.astro has its section's (Ruling Z). The video comes straight under
// the h1 so a phone's first screen shows it, the lead under it.
// The badge is the LiveBadge island: it follows the camera's stream ("Live", "Offline", none for the embed), and
// carries data-impeccable-ignore="pulsing-dot" while live, as in the design's docs (spec §4.3 has it breathe;
// .impeccable/config.json records that ruling).
// The video is the YouTube embed, unless the page fills the `player` slot: the camera page puts its live player there,
// and its right-now panels and two cards in `after` (src/pages/live/index.astro). With `items`, the body's H2 groups of
// H3 items are wrapped (groupItems, src/lib/prose-groups.mjs) for site.css's grid: the camera page's.
import Base from './Base.astro';
import SectionNav from '../components/SectionNav.astro';
import { aiUrl, liveNav } from '../lib/nav.mjs';
import { REEF_CAMERA } from '../lib/live.mjs';
import YouTube from '../components/YouTube.astro';
import LiveBadge from '../islands/LiveBadge';
import { groupItems } from '../lib/prose-groups.mjs';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'live'>;
  /** The video is the reef camera's live stream, so the page shows the live badge. Recorded video has none. */
  live?: boolean;
  /** The other live page, as a button under the lead. */
  link: { href: string; label: string };
  /** The body's H2 groups of H3 items laid out side by side (the camera page's). */
  items?: boolean;
}

const { entry, live = false, link, items = false } = Astro.props;
const { title, description, video, playlist } = entry.data;
const ai = aiUrl(import.meta.env.PUBLIC_AI_URL);
const hasBody = (entry.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim() !== '';
const body = hasBody ? await Astro.slots.render('default') : '';
---
<Base title={title} description={description} theme="dark">
  <div class="wb-container site-article site-live">
    <SectionNav section="live" here={Astro.url.pathname} items={liveNav(ai)} label="Live reef" />
    <div class="site-live__title">
      <h1>{title}</h1>
      {live && <LiveBadge client:load camera={REEF_CAMERA} />}
    </div>
    {Astro.slots.has('player') ? (
      <slot name="player" />
    ) : (
      <YouTube id={video} title={live ? `${title}, live stream` : `${title}, YouTube playlist`} playlist={playlist} />
    )}
    <p class="wb-lead">{description}</p>
    <div class="site-actions">
      <a class="wb-btn wb-btn--ghost wb-btn--wrap" href={link.href}>{link.label}</a>
    </div>
    <slot name="after" />
    {hasBody && <div class="wb-prose site-article__body site-live__body" set:html={items ? groupItems(body) : body} />}
  </div>
</Base>
