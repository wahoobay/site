---
// One page of the pages collection: its section's navigation, the h1, the lead, then the Markdown body.
import Base from './Base.astro';
import { sectionPages, urlOf, type PageEntry } from '../lib/sections';

interface Props {
  entry: PageEntry;
}

const { entry } = Astro.props;
const { title, description, section, hero } = entry.data;
const here = urlOf(entry);
const siblings = await sectionPages(section);

// The description doubles as the lead paragraph, unless the body already says it (then it would read twice).
const flat = (text: string) => text.replace(/\s+/g, ' ').trim();
const body = flat(entry.body ?? '');
const hasBody = body.replace(/<!--[\s\S]*?-->/g, '').trim() !== '';
const showLead = !body.includes(flat(description));
---
<Base title={title} description={description} image={hero}>
  {hero && <img class="site-article__hero" src={hero} alt="" fetchpriority="high">}
  <div class="wb-container site-article">
    {siblings.length > 1 && (
      <nav class="site-subnav" aria-label="In this section">
        <ul>
          {siblings.map((page) => (
            <li>
              <a
                class:list={['wb-nav__link', { 'wb-nav__link--on': urlOf(page) === here }]}
                href={urlOf(page)}
                aria-current={urlOf(page) === here ? 'page' : undefined}
              >{page.data.nav ?? page.data.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <h1>{title}</h1>
    {showLead && <p class="wb-lead">{description}</p>}
    {hasBody && <div class="wb-prose site-article__body"><slot /></div>}
  </div>
</Base>
