---
// One page of the pages collection: its banner (inset, rounded), its section's navigation, the h1, the lead, its
// actions, then the Markdown body. A page's own section goes in the `before` slot (above the body) or `after` (below).
// A figure the Markdown names by its source ({species-documented}) is filled in at build time (fillFigures,
// src/lib/figures.ts; the Support page's impact list, Ruling 58).
import Base from './Base.astro';
import SectionNav from '../components/SectionNav.astro';
import { urlOf, type PageEntry } from '../lib/sections';
import { mediaClass } from '../lib/media.mjs';
import { fillFigures } from '../lib/figures';

interface Props {
  entry: PageEntry;
}

const { entry } = Astro.props;
const { title, description, section, hero, heroPosition, actions = [] } = entry.data;
const here = urlOf(entry);

// The description doubles as the lead paragraph, unless the body already says it (then it would read twice).
const flat = (text: string) => text.replace(/\s+/g, ' ').trim();
const body = flat(entry.body ?? '');
const hasBody = body.replace(/<!--[\s\S]*?-->/g, '').trim() !== '';
const showLead = !body.includes(flat(description));
const html = hasBody ? fillFigures(await Astro.slots.render('default')) : '';

// A button to another site opens in a new tab and says so, like the nav's Donate.
const isExternal = (href: string) => /^https?:\/\//.test(href);
---
<Base title={title} description={description} image={hero}>
  <div class="wb-container site-article">
    {hero && <img class={`${mediaClass(heroPosition)} site-article__hero`} src={hero} alt="" fetchpriority="high">}
    <SectionNav section={section} here={here} />
    <h1>{title}</h1>
    {showLead && <p class="wb-lead">{description}</p>}
    {actions.length > 0 && (
      <div class="site-actions">
        {actions.map(({ label, href, variant }) =>
          isExternal(href) ? (
            <a class={`wb-btn wb-btn--${variant} wb-btn--wrap`} href={href} target="_blank" rel="noopener">{label}<span class="wb-sr-only"> (opens in a new tab)</span></a>
          ) : (
            <a class={`wb-btn wb-btn--${variant} wb-btn--wrap`} href={href}>{label}</a>
          ),
        )}
      </div>
    )}
    <slot name="before" />
    {hasBody && <div class="wb-prose site-article__body" set:html={html} />}
    <slot name="after" />
  </div>
</Base>
