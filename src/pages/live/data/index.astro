---
// /live/data/: the dashboards whose host answers (onlineDashboards(); today the Power BI report), framed, under a line
// leading to the trends page (/live/trends/), which charts the same sensors. Light page.
// Scripts are not sandboxed away: Power BI needs scripts and same-origin inside its own frame. Each panel (Ruling AA):
// its heading (the design's panel title), one line saying the report reads best at full size, the full-size link as the
// primary action, then the frame. Under 48rem the frame is left out (site.css, .site-dashboard__frame): on a phone the
// framed report is drawn at a sixth of its size and cannot be read, and there is no still of it, so the line and the
// button stand alone.
import Base from '../../../layouts/Base.astro';
import SectionNav from '../../../components/SectionNav.astro';
import { aiUrl, liveNav } from '../../../lib/nav.mjs';
import { onlineDashboards } from '../../../lib/dashboards.mjs';

const shown = onlineDashboards();
// katie: review (the description is built from the titles of the dashboards shown, so it never names an offline one)
const description = `Data dashboards: ${shown.map((d) => d.title).join(', ')}.`;
const ai = aiUrl(import.meta.env.PUBLIC_AI_URL);
---
<Base title="Data dashboards" description={description}>
  <div class="wb-container site-article">
    <SectionNav section="live" here={'/live/data/'} items={liveNav(ai)} label="Live reef" />
    <!-- katie: review (new heading: the old pages had none) -->
    <h1>Data dashboards</h1>
    <!-- katie: review (a new sentence: the trends page draws on the same sensors as the Power BI report) -->
    <p class="wb-lead">The <a href="/live/trends/">trends page</a> charts the same sensor history from the reef's own instruments.</p>
    {shown.map((d) => (
      <section class="wb-panel site-dashboard" aria-labelledby={`dash-${d.id}`}>
        <!-- katie: review (new title for this dashboard) -->
        <h2 class="wb-panel__title" id={`dash-${d.id}`}>{d.title}</h2>
        <!-- katie: review (new sentence) -->
        <p>The report reads best at full size.</p>
        <!-- katie: review (new link label) -->
        <a class="wb-btn wb-btn--action" href={d.open} target="_blank" rel="noopener">Open full size<span class="wb-sr-only"> (opens in a new tab)</span></a>
        <div class="wb-video site-dashboard__frame">
          <iframe src={d.src} title={d.title} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      </section>
    ))}
  </div>
</Base>
