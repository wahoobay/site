---
// /live/species/: the species explorer's index. Every species of both lists, the fish-ID app's catalogue
// (src/data/fish.json, `npm run sync:fish`) and the Java API's list with its clips (src/data/species.json and
// media.json, `npm run sync:species`), merged by unionSpecies (src/lib/explorer.mjs) and grouped by category in the
// 2a gallery's order. Each species is a card (src/components/SpeciesCard.astro) linking to its own page,
// /live/species/<slug>/, where its live numbers and its clips are. Under the lead, the categories as a second row of
// the design's section navigation (Ruling 49: anchor links, "Categories" for a screen reader, not sticky), and each
// category ends with the way back up to it. Static: no island and no script (the numbers on the cards are the
// snapshot's), and the browser never asks an API for the lists. Light page.
import Base from '../../../layouts/Base.astro';
import SectionNav from '../../../components/SectionNav.astro';
import SpeciesCard from '../../../components/SpeciesCard.astro';
import { aiUrl, liveNav } from '../../../lib/nav.mjs';
import fish from '../../../data/fish.json';
import species from '../../../data/species.json';
import media from '../../../data/media.json';
import { byCategory, pictureOf, unionSpecies, type Species } from '../../../lib/explorer.mjs';
import { categoryId } from '../../../lib/species.mjs';

// katie: review (the old page's meta description, verbatim)
const description = 'Photos and video clips of every species the Wahoo Bay underwater cameras and volunteers have recorded';

// A category with no species has no heading: an empty one would say none were seen. In a category, the species with a
// picture come first and those without after them, each in the union's name order: a card of words only beside
// pictures would leave a hole under it.
const picturesFirst = (list: Species[]) => [...list.filter((s) => pictureOf(s)), ...list.filter((s) => !pictureOf(s))];
const groups = [...byCategory(unionSpecies(fish, species, media))]
  .filter(([, list]) => list.length > 0)
  .map(([title, list]) => ({ title, id: categoryId(title), species: picturesFirst(list) }));
const ai = aiUrl(import.meta.env.PUBLIC_AI_URL);
---
<Base title="Species" description={description}>
  <div class="wb-container site-article">
    <SectionNav section="live" here={'/live/species/'} items={liveNav(ai)} label="Live reef" />
    <!-- katie: review (new heading: the old page was "Species Photos & Videos") -->
    <h1 id="species-title">Species</h1>
    <!-- katie: review (the lead is the old page's meta description, as a sentence: the explorer lists the fish-ID catalogue's species too) -->
    <p class="wb-lead">{description}.</p>
    <!-- katie: review (new words: the category row's name for a screen reader) -->
    <nav class="site-subnav site-species__jump" id="categories" aria-label="Categories">
      <ul class="wb-subnav">
        {groups.map((g) => (
          <li><a class="wb-nav__link" href={`#${g.id}`}>{g.title}</a></li>
        ))}
      </ul>
    </nav>
    {groups.map((g) => (
      <section class="site-species__group" aria-labelledby={g.id}>
        <!-- katie: review (new heading: the old gallery's category) -->
        <h2 id={g.id}>{g.title}</h2>
        <ul class="site-species" role="list">
          {g.species.map((s) => <SpeciesCard species={s} />)}
        </ul>
        <!-- katie: review (new words: the way back up to the category row) -->
        <p class="site-species__top"><a href="#categories">Back to categories</a></p>
      </section>
    ))}
  </div>
</Base>
