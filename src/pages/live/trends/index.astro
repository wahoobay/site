---
// /live/trends/: the species the reef camera sees and the water and weather sensors' history (TrendsCharts,
// src/islands/TrendsCharts.tsx: a range switch, the latest readings, the species seen per day or week, a line chart
// per measure, each with its CSV), between the lead and the copy (src/content/pages/live/trends.md). Light page.
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SectionNav from '../../../components/SectionNav.astro';
import TrendsCharts from '../../../islands/TrendsCharts';
import { aiUrl, liveNav } from '../../../lib/nav.mjs';

const entry = await getEntry('pages', 'live/trends');
if (!entry) throw new Error('src/content/pages/live/trends.md is missing');
const { Content } = await render(entry);
const { title, description } = entry.data;
const ai = aiUrl(import.meta.env.PUBLIC_AI_URL);
---
<Base title={title} description={description}>
  <div class="wb-container site-article">
    <SectionNav section="live" here={'/live/trends/'} items={liveNav(ai)} label="Live reef" />
    <h1>{title}</h1>
    <p class="wb-lead">{description}</p>
    <TrendsCharts client:visible />
    <div class="wb-prose site-article__body"><Content /></div>
  </div>
</Base>
