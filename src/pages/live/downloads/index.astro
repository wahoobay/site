---
// /live/downloads/: the open data. The lead, the copy (src/content/pages/live/downloads.md: the windows, the README
// and its licence, what the files leave out), then the fish-ID app's public exports as the content file lists them, a
// card each: its name, its line, CSV and Parquet buttons over its default window, and the windows it offers. The files
// are the fish-ID app's, at /api/public/exports/ on the site's own origin; the page links them and fetches nothing.
// A button is its format alone (and, for a screen reader, which file and window); the window is said once, under the
// pair, so the two buttons stay side by side on a phone.
// Light page.
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SectionNav from '../../../components/SectionNav.astro';
import { aiUrl, liveNav } from '../../../lib/nav.mjs';
import { API_BASE } from '../../../lib/public-api.mjs';

const entry = await getEntry('pages', 'live/downloads');
if (!entry) throw new Error('src/content/pages/live/downloads.md is missing');
const { Content } = await render(entry);
const { title, description, exports = [] } = entry.data;
const ai = aiUrl(import.meta.env.PUBLIC_AI_URL);

const FORMATS = [
  { ext: 'csv', label: 'CSV' },
  { ext: 'parquet', label: 'Parquet' },
];
const href = (name: string, ext: string, days: number) => `${API_BASE}/exports/${name}.${ext}?days=${days}`;
// "7 or 30 days", "7, 30, 90 or 365 days".
const windows = (days: number[]) => (days.length > 1 ? `${days.slice(0, -1).join(', ')} or ${days.at(-1)} days` : `${days[0]} days`);
---
<Base title={title} description={description}>
  <div class="wb-container site-article">
    <SectionNav section="live" here={'/live/downloads/'} items={liveNav(ai)} label="Live reef" />
    <h1>{title}</h1>
    <p class="wb-lead">{description}</p>
    <div class="wb-prose site-article__body"><Content /></div>
    <ul class="site-downloads" role="list">
      {exports.map(({ name, description: line, default_days: days, allowed_days: allowed }) => (
        <li class="wb-card site-downloads__item">
          <div class="wb-card__body">
            <h2>{name}</h2>
            <p>{line}</p>
            <p class="site-downloads__files">
              {FORMATS.map(({ ext, label }) => (
                <a class="wb-btn wb-btn--ghost" href={href(name, ext, days)}>{label}<span class="wb-sr-only"> of {name}, {days} days</span></a>
              ))}
            </p>
            <!-- katie: review (new words: the window the buttons download, and the windows a file offers) -->
            <p class="wb-caption">The last {days} days. Windows: {windows(allowed)}.</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
