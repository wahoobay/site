---
// Every page of the pages collection, at the address its file path names (src/content.config.ts).
import { getCollection, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import People from '../components/People.astro';
import LogoGrid from '../components/LogoGrid.astro';
import ParkMapSection from '../components/ParkMapSection.astro';

// The Live reef pages are not built here: each has a page of its own under src/pages/live/ (the Live reef navigation,
// its islands), and its Markdown is that page's copy (src/content/pages/live/trends.md).
export async function getStaticPaths() {
  const pages = await getCollection('pages', (entry) => entry.data.section !== 'live');
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// The two pages whose body is followed by a data collection (src/content/board, src/content/partners).
const below: Record<string, any> = { 'about/board': People, 'get-involved/partners': LogoGrid };
const Below = below[entry.id];
// The page whose body is preceded by a section of its own: the park map, where the page's picture was, so the page
// reads as before (src/content/pages/visit/map.md).
const above: Record<string, any> = { 'visit/map': ParkMapSection };
const Above = above[entry.id];
---
<Page entry={entry}>
  {Above && <Above slot="before" />}
  <Content />
  {Below && <Below slot="after" />}
</Page>
