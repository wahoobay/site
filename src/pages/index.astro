---
// The home page in the Jump In brand (@wahoobay/design 0.5.0; PRODUCT.md, amended 2026-11-24, pending Katie's review),
// dark throughout: the hero on deep water with the nav over its top, the action ticker, the Visit section first
// (CLAUDE.md: visiting the park comes first), then the real content on the dark ground: the live band (the Watch
// chapter), the four impact figures, the photo doorways, the map teaser, the news teaser and the Instagram strip with its
// follow link, then the dark footer.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import VisitSection from '../components/VisitSection.astro';
import LiveBand from '../components/LiveBand.astro';
import Figures from '../components/Figures.astro';
import Doorways from '../components/Doorways.astro';
import MapTeaser from '../components/MapTeaser.astro';
import NewsTeaser from '../components/NewsTeaser.astro';
import Instagram from '../components/Instagram.astro';
import { aiUrl } from '../lib/nav.mjs';
import { REEF_STILL } from '../lib/live.mjs';

// The old home page's intro, verbatim (wahoobay-net-frontend, src/components/MainPage/HeroSection.js): the page's
// description for search engines and link previews.
const intro =
  'Wahoo Bay is a public marine education park at the Hillsboro Inlet, inspiring ocean literacy through hands-on learning, immersive field experiences, and community conservation.';

// The live band's words are the camera page's own (src/content/live/camera.md).
const camera = await getEntry('live', 'camera');
if (!camera) throw new Error('src/content/live/camera.md is missing');
---
<Base title="Wahoo Bay" description={intro} theme="dark" navOver footerTheme="dark">
  <Hero />

  <Ticker />

  <VisitSection />

  <LiveBand
    still={REEF_STILL.src}
    heading={camera.data.title}
    text={camera.data.description}
    ai={aiUrl(import.meta.env.PUBLIC_AI_URL)}
  />

  <section class="wb-container site-figures" aria-label="Our Impact at a Glance">
    <Figures />
  </section>

  <Doorways />

  <MapTeaser />

  <NewsTeaser />

  <Instagram />
</Base>
