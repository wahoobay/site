---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="There is no page at this address on wahoobay.net. Start from the home page or plan a visit." noindex>
  <section class="wb-container site-page">
    <h1>Page not found</h1>
    <p>There is no page at this address.</p>
    <div class="site-page__actions">
      <a class="wb-btn wb-btn--action" href="/">Go to the home page</a>
      <a class="wb-btn wb-btn--ghost" href="/visit/">Plan a visit</a>
    </div>
  </section>
</Base>
