{
  "name": "wahoobay-site",
  "private": true,
  "description": "wahoobay.net, the Wahoo Bay website, built with Astro on the @wahoobay/design system.",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "node --test 'tests/*.test.mjs'",
    "check": "impeccable detect dist/",
    "check:links": "node scripts/check-links.mjs dist",
    "deploy:staging": "scripts/deploy.sh staging",
    "deploy:prod": "scripts/deploy.sh prod",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@wahoobay/design": "github:wahoobay/design#v0.2.1",
    "astro": "7.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "impeccable": "4.8.0",
    "typescript": "6.0.3"
  }
}
